# 邮箱
EMAIL_CALENDAR_EMAIL_PROVIDER=qq
EMAIL_CALENDAR_EMAIL=
EMAIL_CALENDAR_AUTH_CODE=
EMAIL_CALENDAR_IMAP_HOST=imap.qq.com
EMAIL_CALENDAR_IMAP_PORT=993
EMAIL_CALENDAR_MAILBOX_WEB_URL=https://mail.qq.com/
EMAIL_CALENDAR_FETCH_LIMIT=100
EMAIL_CALENDAR_AUTO_SYNC=true
EMAIL_CALENDAR_SYNC_INTERVAL_MINUTES=30

# 日志
EMAIL_CALENDAR_LOG_LEVEL=INFO

# 缓存与保留
EMAIL_CALENDAR_MODEL_CACHE_TTL_HOURS=24
EMAIL_CALENDAR_LOG_RETENTION_DAYS=7
EMAIL_CALENDAR_EVENT_RETENTION_DAYS=30
EMAIL_CALENDAR_CLEANUP_INTERVAL_HOURS=24

# 模型
EMAIL_CALENDAR_MODEL_ENABLED=false
EMAIL_CALENDAR_MODEL_PROVIDER=openai
EMAIL_CALENDAR_MODEL_API_BASE=https://api.openai.com/v1
EMAIL_CALENDAR_MODEL_API_KEY=
EMAIL_CALENDAR_MODEL_NAME=
